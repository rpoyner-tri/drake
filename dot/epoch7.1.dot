digraph G {
  label="This PR: DirectCollocation trajectory callbacks are borrowed; the callback evaluator keeps the callable, and the DirectCollocation keeps the evaluator";
  edge [minlen=2];
  {
    node [shape=plaintext];
    edge [style=invis];
    variables -> Python -> "C++";
  }
  {
    node [shape=plaintext, fontname="Courier"];
    owner;
  }

  pyowner [label="Owner"];
  pydc [label="DirectCollocation"];
  pyeval [label="VisualizationCallback\n(evaluator)"];
  pycb [label="bound method\nself._on_trajectory"];
  cdc [label="DirectCollocation\n(with program)"];
  ceval [label="VisualizationCallback\n(shared_ptr)"];

  { rank = same; variables; owner; }
  { rank = same; Python; pyowner; pydc; pyeval; pycb; }
  { rank = same; "C++"; cdc; ceval; }

  {
    edge [color="#1F77B4", style=bold];
    owner -> pyowner;
    pyowner -> pydc [constraint=false, label="dircol"];
    pydc -> pyeval [constraint=false];
    pycb -> pyowner [constraint=false];
  }

  {
    edge [color="#E377C2", style=bold];
    pyeval -> pycb [constraint=false];
  }

  {
    edge [color="#FF7F0E", style=bold];
    pydc -> cdc;
    pyeval -> ceval;
    cdc -> ceval [constraint=false];
  }

  {
    edge [color="#D62728", style=dotted];
    ceval -> pycb;
  }
}
