digraph G {
  label="After #25093: witness function with calc and event callbacks";
  edge [minlen=2];
  {
    node [shape=plaintext];
    edge [style=invis];
    variables -> Python -> "C++";
  }
  {
    node [shape=plaintext, fontname="Courier"];
    system;
  }
  
  pysys [label="MySystem"];
  pywit [label="WitnessFunction"];
  pycalc [label="bound method\nself._calc"];
  pyev [label="PublishEvent"];
  pycb [label="bound method\nself._on_publish"];
  csys [label="LeafSystem"];
  cwit [label="WitnessFunction"];
  cevclone [label="PublishEvent\n(clone)"];
  cev [label="PublishEvent"];
  
  { rank = same; variables; system; }
  { rank = same; Python; pysys; pywit; pycalc; pyev; pycb; }
  { rank = same; "C++"; csys; cwit; cevclone; cev; }
  
  {
    edge [color="#1F77B4", style=bold];
    system -> pysys;
    pysys -> pywit [constraint=false, label="_witness"];
    pycalc -> pysys [constraint=false];
    pycb -> pysys [constraint=false];
  }
  
  {
    edge [color="#FF7F0E", style=bold];
    pysys -> csys;
    pywit -> cwit;
    cwit -> cevclone [constraint=false];
    pyev -> cev;
  }
  
  {
    edge [color="#D62728", style=dotted];
    cwit -> pycalc;
    cevclone -> pycb;
    cev -> pycb;
  }
  
  {
    edge [color="#9467BD", style=bold, constraint=false, dir=both];
    pysys -> pyev;
  }
  
  {
    edge [color="#E377C2", style=bold, constraint=false];
    pysys -> pycalc;
    pyev -> pycb;
  }
}
