digraph G {
  label="Defect 1 (after): the monitor lives in a single attribute slot; replacing or clearing the monitor releases the previous callable";
  edge [minlen=2];
  {
    node [shape=plaintext];
    edge [style=invis];
    variables -> Python -> "C++";
  }
  {
    node [shape=plaintext, fontname="Courier"];
    simulator;
  }

  pysim [label="Simulator"];
  m1 [label="monitor 1\n(released)", style="dashed,filled", fillcolor="#EEEEEE", fontcolor="#888888"];
  m2 [label="monitor 2\n(released)", style="dashed,filled", fillcolor="#EEEEEE", fontcolor="#888888"];
  m3 [label="monitor 3\n(current)"];
  csim [label="Simulator"];
  cfn [label="std::function\n(current monitor)"];

  { rank = same; variables; simulator; }
  { rank = same; Python; pysim; m1; m2; m3; }
  { rank = same; "C++"; csim; cfn; }

  { edge [color="#1F77B4", style=bold]; simulator -> pysim; }
  { edge [color="#1F77B4", style=bold]; pysim -> m3 [label="_monitor\n(single slot)", fontsize=10, constraint=false]; }
  { edge [color="#999999", style=dashed]; pysim -> m1 [label="replaced", fontsize=10, constraint=false];
    pysim -> m2 [label="replaced", fontsize=10, constraint=false]; }
  { edge [color="#FF7F0E", style=bold]; pysim -> csim; csim -> cfn [constraint=false]; }
  { edge [color="#D62728", style=dotted]; cfn -> m3; }
}
